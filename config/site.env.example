# ==============================================================================
# Per-operator environment for pipeline-v2.
#
# These settings describe WHO is running the pipeline and WHERE, not WHICH run.
# They used to live in each run config, which meant every operator inherited the
# author's paths. Run configs now carry run identity only.
#
# Copy to ~/.pipeline-v2/env and source it from your shell profile:
#     mkdir -p ~/.pipeline-v2 && cp config/site.env.example ~/.pipeline-v2/env
#     echo 'source ~/.pipeline-v2/env' >> ~/.bashrc
#
# Every variable below is optional. The built-in defaults in lib/common.sh are
# correct for a standard Discovery account.
# ==============================================================================

# ── Scratch ─────────────────────────────────────────────────────────────────
# Which scratch file system the pipeline writes to. SCRATCH_BASE defaults to
# $SCRATCH_MOUNT/$USER, so you normally do not set SCRATCH_BASE at all.
# export SCRATCH_MOUNT=/scratch1
# export SCRATCH_BASE=/scratch1/your_username

# ── Part 1 only ─────────────────────────────────────────────────────────────
# Your JSOC export address. It MUST already be registered with JSOC or the
# export request is rejected. Defaults to $USER@usc.edu.
# export JSOC_EMAIL=you@usc.edu

# ── Shared install ──────────────────────────────────────────────────────────
# When the repository is a shared read-only install, point logs and resume
# checkpoints at your own directory so operators do not overwrite each other.
# export LOG_DIR=$HOME/pipeline-v2-state/logs
# export CHECKPOINT_DIR=$HOME/pipeline-v2-state/checkpoints

# ── Rarely needed ───────────────────────────────────────────────────────────
# export PROJECT_BASE=/project2/erhodes_44
# export CONTAINER_IMAGE=/project2/erhodes_44/rcf-04/astro10/singularity/images/spscratch/restore_centos7.2405291154.sif_03_06_2025
